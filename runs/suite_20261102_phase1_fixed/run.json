        "hf": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
        "name": "tinyllama-1.1b-fp32-bs4-seq768",
        "dtype": "float32",
        "batch_size": 4
      },
      {
        "identity": "Beta",
        "chat_template": "config/chat_templates/qwen2.5.jinja",
