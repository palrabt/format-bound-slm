      "lora_compact": {
        "lora": true,
        "prompt": "compact"
      },
      "base_grammar": {
        "lora": false,
        "prompt": "grammar"
      },
      "lora_grammar": {
        "lora": true,
        "prompt": "grammar"
      }
    },
    "training": {
      "corpus": "training/corpus/training_data_synct_15000_llm.txt",
      "epochs": 2,
      "sequence_length": 768,
      "lora": {
        "r": 32,
        "alpha": 64,
        "dropout": 0.05,
        "target_modules": "all_linear"
      },
      "learning_rate": 0.0001,
      "lr_scheduler": "cosine",
      "warmup_ratio": 0.05,
      "effective_batch_size": 64,
      "mixed_precision": "bf16"
    },
    "tournament": {
      "games": 30,
      "conditions": [
        "lora_compact",
        "base_grammar",
        "lora_verbose",
        "base_verbose"
      ],
      "opponents": "bot_reference",
      "baselines": [
        "bot_reference",
        "bot_random"
      ]
    },
    "replay": {
      "corpus": "eval/replay_corpus.json"
    }
  },
