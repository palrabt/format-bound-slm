        "hf": "Qwen/Qwen2.5-3B-Instruct",
        "name": "qwen2.5-3b-instruct-bf16-bs4-seq768",
        "dtype": "bfloat16",
        "batch_size": 2
      },
      {
        "identity": "Gamma",
        "chat_template": "config/chat_templates/gemma.jinja",
        "gguf": "artifacts/gemma-2b-it.gguf",
        "hf": "google/gemma-2b-it",
        "name": "gemma-2b-it-bf16-bs4-seq768",
        "dtype": "bfloat16",
        "batch_size": 2
      }
    ],
    "conditions": {
      "base_verbose": {
        "lora": false,
        "prompt": "verbose"
      },
      "lora_verbose": {
        "lora": true,
        "prompt": "verbose"
      },
      "base_verbose2": {
        "lora": false,
        "prompt": "verbose2"
      },
      "lora_verbose2": {
        "lora": true,
        "prompt": "verbose2"
      },
      "base_compact": {
        "lora": false,
        "prompt": "compact"
