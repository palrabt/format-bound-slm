        "name": "gemma-2b-it-bf16-bs4-seq768",
        "dtype": "bfloat16",
        "batch_size": 2
      }
    ],
    "conditions": {
      "base_verbose": {
        "lora": false,
        "prompt": "verbose"
      },
      "lora_verbose": {
        "lora": true,
        "prompt": "verbose"
      },
      "base_verbose2": {
        "lora": false,
        "prompt": "verbose2"
      },
      "lora_verbose2": {
        "lora": true,
        "prompt": "verbose2"
      },
